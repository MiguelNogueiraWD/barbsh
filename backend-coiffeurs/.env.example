# Database Configuration
# Pour développement local : postgresql://user:password@localhost:5432/barbsh_db
# Pour production (DigitalOcean) : obtenir depuis le dashboard
DATABASE_URL="postgresql://user:password@localhost:5432/barbsh_db"

# JWT Secret (utilisé pour l'authentification)
# IMPORTANT: Générer un secret aléatoire fort pour la production
# Pour générer: openssl rand -base64 32
# Ou en Node.js: require('crypto').randomBytes(32).toString('base64')
JWT_SECRET="CHANGE_THIS_TO_A_SECURE_RANDOM_STRING"

# Email Configuration (Nodemailer - Gmail)
# Pour utiliser Gmail, activer "App Password" dans les paramètres Google
MAIL_USER="votre.email@gmail.com"
MAIL_PASS="votre_mot_de_passe_app"

# Stripe Configuration (Paiements)
# Obtenir depuis https://dashboard.stripe.com/apikeys
# Pour le développement, utiliser les clés TEST (sk_test_...)
STRIPE_SECRET_KEY="sk_test_votre_cle_secrete_stripe"

# Stripe Webhook Secret (pour les webhooks Stripe)
# Obtenir en créant un webhook endpoint dans Stripe Dashboard
STRIPE_WEBHOOK_SECRET="whsec_votre_webhook_secret"

# Stripe Price IDs pour les abonnements
# Créer des "Products" dans Stripe Dashboard puis récupérer les Price IDs
STRIPE_PRICE_PRO="price_votre_id_pro"
STRIPE_PRICE_VIP="price_votre_id_vip"

# Frontend URL (pour les redirections après paiement)
# Local : http://localhost:5173
# Production : https://votre-domaine.com
FRONT_URL="http://localhost:5173"

# Port du serveur backend (optionnel, défaut: 3000)
PORT=3000

# Node Environment
NODE_ENV="development"

# ========================================
# CONFIGURATION AVEC GITHUB STUDENT PACK
# ========================================

# SendGrid (Alternative recommandée pour les emails en production)
# Décommenter ces lignes si vous utilisez SendGrid au lieu de Nodemailer
# SENDGRID_API_KEY="SG.votre_cle_api_sendgrid"
# MAIL_FROM="noreply@votre-domaine.com"

# DigitalOcean Database (Production)
# Exemple d'URL de connexion DigitalOcean
# DATABASE_URL="postgresql://doadmin:password@db-postgresql-nyc1-12345.ondigitalocean.com:25060/defaultdb?sslmode=require"

# Sentry (Monitoring des erreurs - optionnel)
# SENTRY_DSN="https://xxx@xxx.ingest.sentry.io/xxx"

# Notes importantes :
# 1. Ne JAMAIS committer ce fichier dans Git (ajouté dans .gitignore)
# 2. Utiliser les clés TEST de Stripe pendant le développement
# 3. Changer tous les secrets avant de passer en production
# 4. Pour les étudiants : consultez STUDENT_GUIDE.md pour configurer avec le pack étudiant
